{
  "name": "blindcode",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "description": "BlindCode — Code Without Sight for Code Sastra, REC Azamgarh",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build && npm run build:server",
    "build:server": "tsc -p server/tsconfig.json --outDir server/dist --noEmit false",
    "start": "node server/dist/src/index.js",
    "typecheck": "npm --prefix client run typecheck && tsc --noEmit -p server/tsconfig.json",
    "test": "tsx --test server/src/scoring.test.ts",
    "admin:hash": "tsx server/scripts/hash-password.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "diff": "^9.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "postcss-selector-parser": "^7.1.7"
  }
}
